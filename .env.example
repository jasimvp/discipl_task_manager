# Server Port (Render / Railway / VPS injects this automatically)
PORT=5000

# Secret key for signing JWT auth tokens (Set to a long random secret in production)
JWT_SECRET=deciple-enterprise-taskflow-secret-key-2026-production

# Node Environment ('production' or 'development')
NODE_ENV=production

# SQLite database file path (can be stored on a persistent volume mount e.g. /data/taskmanager.db)
# DB_PATH=/data/taskmanager.db
